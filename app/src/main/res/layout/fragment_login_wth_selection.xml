<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/constraint_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.fragments.common.LoginWthSelectionFragment">

    <!-- Title -->
    <TextView
        android:id="@+id/tv_login_with"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="64dp"
        android:layout_marginTop="48dp"
        android:text="@string/login_with"
        android:textColor="@android:color/white"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Scan QR Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_scan_qr"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        app:cardBackgroundColor="#10FFFFFF"
        app:cardCornerRadius="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/card_mobile"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@android:color/transparent"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/iv_qr"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:src="@drawable/qr" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Mobile Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_mobile"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        app:cardBackgroundColor="#10FFFFFF"
        app:cardCornerRadius="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/card_scan_qr"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@android:color/transparent"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/iv_mobile"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:src="@drawable/mobile" />
    </com.google.android.material.card.MaterialCardView>


    <!-- Scan QR Label -->
    <TextView
        android:id="@+id/tv_scan_qr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Scan QR"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="@id/card_scan_qr"
        app:layout_constraintStart_toStartOf="@id/card_scan_qr"
        app:layout_constraintTop_toBottomOf="@id/card_scan_qr" />

    <!-- Mobile Label -->
    <TextView
        android:id="@+id/tv_mobile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Mobile"
        android:textColor="#99FFFFFF"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="@id/card_mobile"
        app:layout_constraintStart_toStartOf="@id/card_mobile"
        app:layout_constraintTop_toBottomOf="@id/card_mobile" />

</androidx.constraintlayout.widget.ConstraintLayout>
