<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.fragments.tvshows.TvHomeScreenFragment">

    <!--Background Images -->
    <FrameLayout
        android:id="@+id/layout_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/sp_bg_img"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            tools:src="@drawable/slid_1" />

    </FrameLayout>

    <!-- Foreground Items -->
    <!-- Scrollable Content (RecyclerView that covers slider) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white_9_percent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Hero Content (Title, buttons, etc) -->
            <LinearLayout
                android:id="@+id/layout_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="48dp"
                android:paddingTop="80dp"
                android:paddingEnd="48dp"
                android:paddingBottom="24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Title -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_hero_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="#80000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="4"
                    android:textColor="@color/white"
                    android:textSize="56sp"
                    android:textStyle="bold"
                    tools:text="@string/app_name" />

                <!-- Metadata -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_hero_metadata"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/light_gray"
                    android:textSize="16sp"
                    tools:text="@string/app_name" />

                <!-- Genres -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_hero_genres"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/light_gray"
                    android:textSize="16sp"
                    tools:text="@string/app_name" />

                <!-- Description -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_hero_description"
                    android:layout_width="500dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:ellipsize="end"
                    android:lineSpacingMultiplier="1.2"
                    android:maxLines="3"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    tools:text="@string/scan_qr" />

                <!-- Rating Bar -->
                <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
                    android:id="@+id/starContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal" />

                <!-- Buttons -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal">

                    <!-- Watch Btn -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_watch_now"
                        style="@style/Widget.WatchNowButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:nextFocusUp="@id/top_bar"
                        android:text="@string/watch_now"
                        app:strokeColor="@color/white" />

                    <!-- Trailer Btn -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_trailer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:text="@string/trailer"
                        android:textAlignment="center"
                        android:textColor="@color/white"
                        app:backgroundTint="@color/white_9_percent"
                        app:cornerRadius="8dp"
                        app:strokeColor="@color/white"
                        app:strokeWidth="1dp" />

                    <!-- Add Button -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_add"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:layout_marginStart="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:scaleType="centerCrop"
                        app:cardBackgroundColor="@color/white_9_percent"
                        app:cardCornerRadius="6dp"
                        app:strokeColor="@color/white"
                        app:strokeWidth="1dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_plush_bnt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_add_white" />

                    </com.google.android.material.card.MaterialCardView>

                    <!-- BookMark -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_bookmark"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:layout_marginStart="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:scaleType="centerCrop"
                        app:cardBackgroundColor="@color/white_9_percent"
                        app:cardCornerRadius="6dp"
                        app:strokeColor="@color/white"
                        app:strokeWidth="1dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_plush"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_bookmark" />

                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

            </LinearLayout>

            <!-- Star Cast Display -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_gradient_transparent_black"
                android:orientation="vertical"
                android:paddingTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layout_text">

                <!-- Cast -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp">

                    <!-- Title-->
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tv_title_rv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cast"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/line_red_gred"
                        android:layout_width="70dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:src="@drawable/line"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_title_rv" />

                    <!-- All Cast Text -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_all_star_cast"
                        style="@style/TransparentNextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:drawableEnd="@drawable/ic_arrow_forward"
                        android:drawablePadding="8dp"
                        android:focusable="true"
                        android:text="@string/all_cast"
                        android:textColor="@color/white"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_star_cast"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:clipToPadding="false"
                        android:descendantFocusability="afterDescendants"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:nestedScrollingEnabled="false"
                        android:nextFocusUp="@id/btn_watch_now"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="1.0"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/line_red_gred"
                        tools:listitem="@layout/item_star_cast" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Related Movies Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="48dp"
                    android:orientation="vertical"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tv_title_upcoming"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/related_movie"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/line_red_gred_upcoming"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:src="@drawable/line" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_season_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:clipToPadding="false"
                        android:descendantFocusability="afterDescendants"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:nestedScrollingEnabled="false"
                        android:nextFocusUp="@id/rv_star_cast" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_related_movie"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:clipToPadding="false"
                        android:descendantFocusability="afterDescendants"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:nestedScrollingEnabled="false"
                        android:nextFocusUp="@id/rv_season_text" />

                </LinearLayout>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>