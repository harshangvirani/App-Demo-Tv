<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.fragments.movies.MoviesFragment">

    <!-- Background Image Slider (Fixed at back) -->
    <FrameLayout
        android:id="@+id/background_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_bg_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:scaleType="fitXY" />
    </FrameLayout>

    <!-- Scrollable Content (RecyclerView that covers slider) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white_9_percent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Hero Content (Title, buttons, etc) -->
            <LinearLayout
                android:id="@+id/layout_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="48dp"
                android:paddingTop="80dp"
                android:paddingEnd="48dp"
                android:paddingBottom="24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Title -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_hero_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="#80000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="4"
                    android:textColor="@color/white"
                    android:textSize="56sp"
                    android:textStyle="bold"
                    tools:text="@string/app_name" />

                <!-- Metadata -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_hero_metadata"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/light_gray"
                    android:textSize="16sp"
                    tools:text="@string/app_name" />

                <!-- Genres -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_hero_genres"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/light_gray"
                    android:textSize="16sp"
                    tools:text="@string/app_name" />

                <!-- Description -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_hero_description"
                    android:layout_width="500dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:ellipsize="end"
                    android:lineSpacingMultiplier="1.2"
                    android:maxLines="3"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    tools:text="@string/scan_qr" />

                <!-- Rating Bar -->
                <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
                    android:id="@+id/starContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal" />

                <!-- Buttons -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal">

                    <!-- Watch Btn -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_watch_now"
                        style="@style/Widget.WatchNowButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:nextFocusUp="@id/top_bar"
                        android:text="@string/watch_now"
                        app:strokeColor="@color/white" />

                    <!-- Trailer Btn -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_trailer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:text="@string/trailer"
                        android:textAlignment="center"
                        android:textColor="@color/white"
                        app:backgroundTint="@color/white_9_percent"
                        app:cornerRadius="8dp"
                        app:strokeColor="@color/white"
                        app:strokeWidth="1dp" />

                    <!-- Add Button -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_add"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:layout_marginStart="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:scaleType="centerCrop"
                        app:cardBackgroundColor="@color/white_9_percent"
                        app:cardCornerRadius="6dp"
                        app:strokeColor="@color/white"
                        app:strokeWidth="1dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_plush"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_add_white" />

                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

            </LinearLayout>

            <!-- Slider Images -->
            <LinearLayout
                android:id="@+id/slider_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="250dp"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintBottom_toTopOf="@+id/list_layout"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- ViewPager -->
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vp_movies"
                    android:layout_width="350dp"
                    android:layout_height="160dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingStart="80dp"
                    android:paddingEnd="80dp"
                    tools:verticalScrollbarPosition="defaultPosition" />


                <!-- Segmented Line Indicator (Center Right - Horizontal) -->
                <LinearLayout
                    android:id="@+id/ll_line_indicators"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="24dp"
                    android:orientation="horizontal" />
            </LinearLayout>

            <!-- Content Section with solid background -->
            <LinearLayout
                android:id="@+id/list_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_gradient_transparent_black"
                android:orientation="vertical"
                android:paddingTop="100dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layout_text">

                <!-- Category Recycler View -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_category"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:clipToPadding="false"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nestedScrollingEnabled="false"
                    android:nextFocusUp="@id/btn_watch_now"
                    android:paddingHorizontal="48dp"
                    tools:listitem="@layout/item_chip_tv_show_category" />

                <!-- Top pick for you Section -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_top_movies"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clipToPadding="false"
                    android:descendantFocusability="afterDescendants"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nestedScrollingEnabled="false"
                    android:nextFocusUp="@id/rv_category"
                    android:paddingHorizontal="48dp"
                    tools:listitem="@layout/item_tv_show_list" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>