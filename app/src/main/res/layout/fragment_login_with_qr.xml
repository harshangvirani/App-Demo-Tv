<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.fragments.common.LoginWithQrFragment">

    <!-- Back Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="36dp"
        android:layout_marginTop="36dp"
        android:focusable="true"
        app:backgroundTint="@android:color/transparent"
        app:icon="@drawable/ic_arrow_back"
        app:iconTint="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Main Container -->
    <LinearLayout
        android:id="@+id/mainContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="28dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_back">

        <!-- ================= LEFT SIDE ================= -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_title_scan_qr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/scan_qr"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="36sp"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_sub_title_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="to access activation code"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="20sp"
                app:layout_constraintTop_toBottomOf="@id/tv_title_scan_qr" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_qr"
                android:layout_width="160dp"
                android:layout_height="160dp"
                app:layout_constraintBottom_toTopOf="@id/tv_code"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_sub_title_text"
                tools:src="@color/white" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="36sp"
                app:layout_constraintBottom_toBottomOf="parent"
                tools:text="254-155" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ================= DIVIDER ================= -->
        <ImageView
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="24dp"
            android:src="@drawable/vertical_divider" />

        <!-- ================= RIGHT SIDE ================= -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_title_login_with_qr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp"
                android:text="@string/login_with_qr"
                android:textColor="@color/white"
                android:textSize="36sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_sub_title_line_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:maxLines="2"
                android:text="Lorem ipsum dolor sit amet."
                android:textColor="@color/white"
                android:textSize="20sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_title_login_with_qr" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_sub_title_line_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:maxLines="2"
                android:text="Scan QR using mobile app."
                android:textColor="@color/white"
                android:textSize="20sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_sub_title_line_1" />

            <!-- Buttons -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_resend"
                android:layout_width="200dp"
                android:layout_height="50dp"
                android:layout_marginTop="150dp"
                android:focusable="true"
                android:text="@string/resend"
                android:textColor="@color/red"
                app:cornerRadius="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_sub_title_line_2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel"
                android:layout_width="200dp"
                android:layout_height="50dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="150dp"
                android:focusable="true"
                android:text="@string/cancel"
                android:textColor="@color/red"
                app:cornerRadius="12dp"
                app:layout_constraintStart_toEndOf="@id/btn_resend"
                app:layout_constraintTop_toBottomOf="@+id/tv_sub_title_line_2" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
