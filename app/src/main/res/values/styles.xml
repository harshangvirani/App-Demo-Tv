<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TransparentNextButton">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="HeaderText">
        <item name="android:textSize">42sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <style name="InputField">
        <item name="android:background">@drawable/bg_input_selector</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textColorHint">#99FFFFFF</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="CircleImage">
        <item name="cornerSize">50%</item>
    </style>

    <style name="TvTabBarText">
        <item name="android:textColor">@color/tab_text_color</item>
        <item name="android:textSize">14sp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/tab_selector</item>
    </style>

    <style name="Widget.MyApp.SubscriptionButton.Selected">
        <item name="cornerRadius">8dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="backgroundTint">@color/red_primary</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Subscription.Plan.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="Subscription.Plan.Subtitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/gray</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Subscription.Screen.Title" parent="TextAppearance.Material3.HeadlineSmall">

        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>

    </style>

    <style name="Subscription.Screen.Subtitle" parent="TextAppearance.Material3.BodyMedium">

        <item name="android:textColor">#CBD5E1</item>
        <item name="android:textSize">18sp</item>
        <item name="android:gravity">center</item>

    </style>

    <style name="ToggleButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@android:color/black</item>
        <item name="android:backgroundTint">@android:color/transparent</item>
    </style>

    <style name="CustomTextInputStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/white</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="hintTextColor">@color/white_9_percent</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:background">@color/white_9_percent</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="CustomTextInputEditTextStyle" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:background">@color/white_9_percent</item>
    </style>

    <style name="Widget.WatchNowButton" parent="Widget.MaterialComponents.Button">
        <item name="android:paddingStart">8dp</item> <!-- Padding -->
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="backgroundTint">@color/red</item><!-- Colors -->
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">4dp</item> <!-- Shape -->
        <item name="icon">@drawable/ic_fill_arrow_forward</item> <!-- Icon -->
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">6dp</item>
        <item name="iconSize">30dp</item>
        <item name="drawableTint">@color/white</item>
        <item name="android:textAllCaps">false</item><!-- Text -->
        <item name="android:gravity">center</item>
    </style>

    <style name="PosterShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeCircle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Theme.HalfScreenTransparentDialog" parent="Theme.MaterialComponents.DayNight.Dialog">
        <!-- Make window background transparent -->
        <item name="android:windowBackground">@android:color/transparent</item>
        <!-- Optional: set dim amount (0.0 for no dim, 0.5 for a slight dim) -->
        <item name="android:backgroundDimAmount">0.5</item>
    </style>

    <style name="CustomDialogTheme" parent="Theme.Material3.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@style/SlideDialogAnimation</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="SlideDialogAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_in_right</item>
        <item name="android:windowExitAnimation">@anim/slide_out_right</item>
    </style>



</resources>