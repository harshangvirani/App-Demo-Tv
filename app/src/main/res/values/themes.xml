<resources>

    <!-- Base Leanback Material Theme -->
    <style name="Theme.LiveStreamingTV" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Keep Leanback window background -->
        <item name="android:windowBackground">@drawable/background_tv</item>

    </style>

    <style name="Widget.MyApp.SubscriptionButton" parent="Widget.Material3.Button">
        <!-- Default (Unselected) -->
        <item name="cornerRadius">12dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/white</item>
        <item name="backgroundTint">@color/white_9_percent</item>
        <item name="android:textColor">@color/white</item>
    </style>

</resources>
